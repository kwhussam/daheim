# Daheim+ Agent - lokale Entwicklungskonfiguration (Beispiel, KEINE echten Secrets)
DAHEIM_HA_MODE=mock
DAHEIM_API_TOKEN=dev-local-token
DAHEIM_DB_PATH=./data/daheim.db

# Nur erforderlich, wenn DAHEIM_HA_MODE=live:
# DAHEIM_HA_URL=http://homeassistant.local:8123
# DAHEIM_HA_TOKEN=<long-lived-access-token>
# DAHEIM_HA_ENABLE_AREA_REGISTRY=true
